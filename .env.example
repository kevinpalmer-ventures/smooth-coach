# Smooth Coach environment variables
#
# Copy to a file that is never committed (for example smooth-coach.env), fill in the
# values, and pass it to the container:
#   docker run -d -p 3000:3000 --env-file smooth-coach.env venturesconsulting/smooth-coach:2.0.1
#
# Format rules for Docker --env-file: one NAME=value per line, no quotes around values,
# no inline comments. Store real values in a secret manager; never commit them.
#
# All seven required variables must be set and non-empty, or the server refuses to
# start and names the ones that are missing.

# --- Database (required) -------------------------------------------------------------
# PostgreSQL 14+ connection string for the app role created by
# deploy/postgres/setup-smooth-coach-postgres.sh. URL-encode the password.
# TLS is controlled here: sslmode=verify-full validates the server certificate; add
# &sslrootcert=/path/to/ca.pem if the provider uses its own CA (mount the file into
# the container). Use sslmode=disable only for a local test database.
# Example: postgresql://smooth_coach_app:URL_ENCODED_PASSWORD@db.example.com:5432/smooth_coach?sslmode=verify-full
DATABASE_URL=

# --- Session signing (required) ------------------------------------------------------
# Secret used to sign and verify the app's own login cookie. Any long random value;
# changing it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MANUS_JWT_SECRET=

# --- Manus sign-in (required) --------------------------------------------------------
# From the Manus project. Manus must accept https://<your-domain>/api/auth/callback
# as a sign-in redirect for this project.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# --- Manus storage for progress photos (required) ------------------------------------
# From the Manus project.
MANUS_API_URL=
MANUS_API_KEY=

# --- Optional ------------------------------------------------------------------------
# Port the server listens on inside the container (default 3000).
# PORT=3000
# The Docker image already sets NODE_ENV=production. Any other value starts the Vite
# development server instead of serving the built app.
# NODE_ENV=production
